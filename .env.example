# DeepSeek 密钥只放在服务端，不要写入 HTML、前端 JS 或提交到 Git
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 通义千问视觉模型（阿里云百炼 DashScope），用于拍照识别食材；不配置时照片识别明确不可用
QWEN_API_KEY=
QWEN_VISION_MODEL=qwen-vl-max
QWEN_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 本机与通用 Node 部署；Vercel 会自动管理端口，不需要设置 PORT
PORT=8787
AI_RATE_LIMIT_PER_MINUTE=30
AI_TIMEOUT_MS=45000

# 仅供通用 Node 反向代理部署；Vercel 环境会自动启用可信代理识别
TRUST_PROXY=false

# RAG 知识库（仅服务端 / Codex automation 使用；不要暴露 secret 或 service role key）
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# 旧项目也可改用 SUPABASE_SERVICE_ROLE_KEY；二者只需配置一个
SUPABASE_SERVICE_ROLE_KEY=

# Voyage AI embedding；模型和维度按 CODEX_RAG_SPEC.md 固定
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-4
EMBEDDING_DIM=1024
EMBEDDING_API_KEY=
