    "rag:book:ingest": "node tools/workflow/ingest-epub-book.mjs",
    "rag:images:import": "node tools/workflow/import-source-images.mjs",
    "rag:images:evidence": "node tools/workflow/prepare-source-image-evidence.mjs",
    "rag:validate:baseline": "node tools/workflow/prepare-recipe-validation-baseline.mjs",
    "rag:snapshot": "node tools/workflow/create-recipe-snapshot.mjs",
    "rag:validate": "node tools/workflow/validate-recipe.mjs",
    "rag:validate:batch": "node tools/workflow/validate-recipe-batch.mjs",
    "start": "node server.mjs",
    "test": "node tests/test_html_demo.mjs && node tests/test_recipe_presentation.mjs",
    "test:ai": "node tests/test_deepseek_integration.mjs",
    "test:rag:ingestion": "node tests/workflow/test-rag-ingestion.mjs",
    "test:rag:repositories": "node tests/workflow/test-rag-repositories.mjs",
    "test:rag:resource": "node tests/workflow/test-resource-extractors.mjs",
    "test:rag:epub": "node tests/workflow/test-epub-extractor.mjs",
    "test:workflow:agents": "node tests/workflow/test-agent-contracts.mjs",
    "test:workflow:artifacts": "node tools/workflow/validate-workflow-artifacts.mjs && node tests/workflow/test-user-selected-artifacts.mjs",
    "test:workflow:validator": "node tests/workflow/test-recipe-validator.mjs && node tests/workflow/test-step-metadata.mjs && node tests/workflow/test-component-metadata.mjs",
    "test:workflow:source-images": "node tests/workflow/test-source-policy.mjs && node tests/workflow/test-source-images.mjs && node tests/workflow/test-windows-http.mjs",
    "test:workflow:language": "node tests/workflow/test-recipe-language.mjs",
    "test:workflow:deterministic": "npm run test:workflow:state && npm run test:rag:repositories && npm run test:rag:ingestion && npm run test:rag:resource && npm run test:rag:epub && npm run test:workflow:agents && npm run test:workflow:validator && npm run test:workflow:source-images && npm run test:workflow:language && npm run test:workflow:artifacts && node tools/build_html_demo_data.mjs && npm test && npm run build",
    "test:workflow:state": "node tools/workflow/generate-recipe-progress.mjs --check && node tools/workflow/validate-run-state.mjs",
    "test:vercel": "npm run build && node tests/test_vercel_functions.mjs",
    "test:all": "npm run test && npm run test:ai && npm run test:vercel",
    "test:assistant": "npm run build && node tests/test_assistant.mjs",
    "test:assistant:ui": "node tests/test_assistant_ui.mjs"
