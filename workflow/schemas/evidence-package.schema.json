{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yanhuo-youpu.local/schemas/evidence-package.schema.json",
  "title": "Recipe Evidence Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["recipeId", "recipeName", "category", "createdAt", "sources", "ragEvidence", "notes"],
  "properties": {
    "recipeId": { "type": "string", "pattern": "^(cn|west)-[0-9]{3}$" },
    "recipeName": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "enum": ["chinese", "western"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/sourceEvidence" }
    },
    "ragEvidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chunkId", "documentId", "sourceName", "chunkType", "content"],
        "properties": {
          "chunkId": { "type": "string", "minLength": 1 },
          "documentId": { "type": "string", "minLength": 1 },
          "sourceName": { "type": "string", "minLength": 1 },
          "chunkType": { "type": "string", "enum": ["summary", "ingredients", "steps", "technique", "tips"] },
          "content": { "type": "string", "minLength": 1 },
          "similarity": { "type": ["number", "null"] }
        }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "ingredient": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "raw"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "amount": { "type": ["string", "null"] },
        "raw": { "type": "string", "minLength": 1 }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": true,
      "required": ["order", "instruction"],
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "instruction": { "type": "string", "minLength": 1 },
        "duration": { "type": ["string", "null"] },
        "heat": { "type": ["string", "null"] }
      }
    },
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceName", "sourceType", "url", "documentId", "retrievalMethod", "complete", "ingredients", "steps", "technique", "tips", "rawExcerpt"],
      "properties": {
        "sourceName": { "type": "string", "minLength": 1 },
        "sourceType": { "type": "string", "enum": ["website", "book"] },
        "url": { "type": ["string", "null"] },
        "documentId": { "type": "string", "minLength": 1 },
        "retrievalMethod": { "type": "string", "minLength": 1 },
        "complete": { "const": true },
        "ingredients": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ingredient" } },
        "steps": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/step" } },
        "technique": { "type": "array", "items": { "type": "string" } },
        "tips": { "type": "array", "items": { "type": "string" } },
        "rawExcerpt": { "type": "string", "minLength": 1 },
        "bookTitle": { "type": ["string", "null"] },
        "pageStart": { "type": ["integer", "null"], "minimum": 1 },
        "pageEnd": { "type": ["integer", "null"], "minimum": 1 },
        "location": { "type": ["string", "null"] }
      }
    }
  }
}
