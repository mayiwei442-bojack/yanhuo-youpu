    "steps": [
      { "stepOrder": 1, "adjacentText": "鲈鱼处理后加料酒和盐腌制30分钟。", "originalUrl": "https://cp1.douguo.com/upload/caiku/c/e/7/800_cee257b8f8be7a99fed2016e16b48897.jpg" },
      { "stepOrder": 2, "adjacentText": "葱切丝泡冰水，姜和小米辣改刀。", "originalUrl": "https://cp1.douguo.com/upload/caiku/6/2/7/800_62edfeb94d070f6d8762a5ad1022a807.jpg" },
      { "stepOrder": 3, "adjacentText": "盘子里放几片姜。", "originalUrl": "https://cp1.douguo.com/upload/caiku/2/3/a/800_23fd7567bafe3734c7dbca6123a71dfa.jpg" },
      { "stepOrder": 4, "adjacentText": "放上鲈鱼，鱼腹和表面放葱姜。", "originalUrl": "https://cp1.douguo.com/upload/caiku/1/a/4/800_1af458ac86a055f13b0c61f06e094434.jpg" },
      { "stepOrder": 5, "adjacentText": "水开后蒸8分钟左右。", "originalUrl": "https://cp1.douguo.com/upload/caiku/0/b/7/800_0bf2dd4a5fbe3d47b91f750d292c7fe7.jpg" },
      { "stepOrder": 6, "adjacentText": "生抽、糖、香油和纯净水调汁。", "originalUrl": "https://cp1.douguo.com/upload/caiku/1/6/e/800_16206d901e23138476f05358e3e8889e.jpg" },
      { "stepOrder": 7, "adjacentText": "倒掉蒸鱼水，重新放葱姜丝和小米辣。", "originalUrl": "https://cp1.douguo.com/upload/caiku/1/7/c/800_178dc8fd4047d32a02dbc76850cdb7ac.jpg" },
      { "stepOrder": 8, "adjacentText": "淋料汁，热油浇鱼身。", "originalUrl": "https://cp1.douguo.com/upload/caiku/b/f/9/800_bf784ec6af27ddf2a904f72cbcaada19.jpg" }
    ]
